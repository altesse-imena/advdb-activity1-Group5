;color:#555555&quot;&gt;Derivations: age = today − date_of_birth; end_time = start_time + duration_minutes;&lt;br&gt;available_spots = max_capacity − COUNT(enrollments)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="1036" width="540" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>